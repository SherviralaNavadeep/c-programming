#include <stdio.h>
struct Node {
    int data;
    struct Node *next;
};

int main() {
    struct Node a, b, c;

    a.data = 10;
    b.data = 20;
    c.data = 30;

    a.next = &b;
    b.next = &c;
    c.next = NULL;

    struct Node *temp = &a;

    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }

    printf("NULL");
    return 0;
}
